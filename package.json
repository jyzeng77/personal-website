{
  "name": "jerry-personal-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
